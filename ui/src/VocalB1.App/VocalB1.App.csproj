<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VocalB1.Core\VocalB1.Core.csproj" />
    <ProjectReference Include="..\VocalB1.Engine\VocalB1.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single application icon: used for the exe and the window title bar. -->
    <Resource Include="..\..\..\VocalB1_Version_1.0.ico" Link="Assets\VocalB1.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 可双击运行的入口名 -->
    <AssemblyName>VocalB1</AssemblyName>
    <ApplicationIcon>..\..\..\VocalB1_Version_1.0.ico</ApplicationIcon>
    <RootNamespace>VocalB1.App</RootNamespace>
  </PropertyGroup>

</Project>
