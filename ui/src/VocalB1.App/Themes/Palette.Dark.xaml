<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme palette: pure grayscale, hierarchy expressed only through brightness -->
    <Color x:Key="BgColor">#1C1C1C</Color>
    <Color x:Key="PanelColor">#212121</Color>
    <Color x:Key="PanelAltColor">#2A2A2A</Color>
    <Color x:Key="BorderColor">#3A3A3A</Color>
    <Color x:Key="InputColor">#171717</Color>
    <Color x:Key="TextColor">#E4E4E4</Color>
    <Color x:Key="DimColor">#9A9A9A</Color>
    <Color x:Key="AccentColor">#DCDCDC</Color>
    <Color x:Key="AccentSoftColor">#3C3C3C</Color>
    <Color x:Key="PitchColor">#F0F0F0</Color>
    <Color x:Key="WarnColor">#C0C0C0</Color>
    <Color x:Key="ErrorColor">#FFFFFF</Color>

    <Color x:Key="HoverColor">#333333</Color>
    <Color x:Key="HoverBorderColor">#4A4A4A</Color>
    <Color x:Key="PressedColor">#404040</Color>
    <Color x:Key="SliderTrackColor">#6A6A6A</Color>
    <Color x:Key="ThumbBorderColor">#4A4A4A</Color>
    <Color x:Key="ThumbHoverColor">#F4F4F4</Color>
    <Color x:Key="ThumbPressColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PitchBrush" Color="{StaticResource PitchColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="{StaticResource SliderTrackColor}" />
    <SolidColorBrush x:Key="ThumbBorderBrush" Color="{StaticResource ThumbBorderColor}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{StaticResource ThumbHoverColor}" />
    <SolidColorBrush x:Key="ThumbPressBrush" Color="{StaticResource ThumbPressColor}" />

</ResourceDictionary>
