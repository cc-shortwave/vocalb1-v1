<Window x:Class="VocalB1.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VocalB1.App.Controls"
        xmlns:converters="clr-namespace:VocalB1.App.Converters"
        Title="VocalB1 Studio"
        Icon="Assets/VocalB1.ico"
        Height="900" Width="1480"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NodeFieldVisibilityConverter x:Key="NodeFieldVis" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullVis" />
        <converters:NullToVisibilityConverter x:Key="NullVis" />
        <converters:EnumDisplayConverter x:Key="EnumText" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RenderCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Height="52" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VocalB1" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Studio" Margin="6,2,0,0" Foreground="{DynamicResource DimBrush}" />
                    <TextBlock Text="{Binding ProjectPathText}" Margin="14,2,0,0"
                               Foreground="{DynamicResource DimBrush}" MaxWidth="280"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新建" Command="{Binding NewProjectCommand}" />
                    <Button Content="打开" Command="{Binding OpenProjectCommand}" />
                    <Button Content="保存" Command="{Binding SaveProjectCommand}" />
                    <Button Content="示例" Command="{Binding LoadDemoCommand}" />
                    <Button Content="撤销" Command="{Binding UndoCommand}" />
                    <Button Content="重做" Command="{Binding RedoCommand}" />
                    <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}" />
                    <ComboBox Width="104" Margin="8,0,0,0" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" />
                    <Button Content="帮助" Command="{Binding OpenHelpCommand}" />
                    <Button Content="渲染 (F5)" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RenderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Outliner: three data-block libraries -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="*" MinHeight="110" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6"
                            Margin="0,0,0,6"
                            Visibility="{Binding IsLegacyReadOnly, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="旧版 v2 工程：只读（可渲染）" Foreground="White" FontWeight="Bold" />
                    </Border>

                        <Expander Grid.Row="1" Header="歌词库" IsExpanded="True">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+" Width="28" Command="{Binding AddLyricCommand}" ToolTip="新建歌词" />
                                    <Button Content="复制" Command="{Binding DuplicateLyricCommand}" />
                                    <Button Content="删除" Command="{Binding RemoveLyricCommand}" />
                                    <Button Content="伪用户" Command="{Binding ToggleLyricFakeCommand}"
                                            ToolTip="Fake User：0 用户时也不清理" />
                                </StackPanel>
                                <Grid>
                                    <ListBox x:Name="LyricList" ItemsSource="{Binding Lyrics}" SelectedItem="{Binding SelectedLyric}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource DimBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="暂无歌词，点击 + 新建">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=LyricList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Expander>

                        <Expander Grid.Row="2" Header="参数库" IsExpanded="True">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+" Width="28" Command="{Binding AddParameterSetCommand}" />
                                    <Button Content="复制" Command="{Binding DuplicateParameterSetCommand}" />
                                    <Button Content="删除" Command="{Binding RemoveParameterSetCommand}" />
                                    <Button Content="伪用户" Command="{Binding ToggleParameterFakeCommand}" />
                                </StackPanel>
                                <Grid>
                                    <ListBox x:Name="ParameterList" ItemsSource="{Binding ParameterSets}" SelectedItem="{Binding SelectedParameterSet}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource DimBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="暂无参数集，点击 + 新建">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ParameterList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Expander>

                        <Expander Grid.Row="3" Header="歌手库" IsExpanded="True">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="+" Width="28" Command="{Binding AddSingerCommand}" />
                                    <Button Content="复制" Command="{Binding DuplicateSingerCommand}" />
                                    <Button Content="删除" Command="{Binding RemoveSingerCommand}" />
                                    <Button Content="伪用户" Command="{Binding ToggleSingerFakeCommand}" />
                                </StackPanel>
                                <Grid>
                                    <ListBox x:Name="SingerList" ItemsSource="{Binding Singers}" SelectedItem="{Binding SelectedSinger}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                                  ToolTip="停用的歌手不参与渲染" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="暂无歌手，点击 + 新建">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=SingerList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Expander>

                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button Content="清理孤立数据块" Command="{Binding PurgeOrphansCommand}" />
                            <TextBlock Text="规则：歌词与歌手一对一；参数可被多个歌手共享；0 用户且无伪用户才会被清理。"
                                       FontSize="11" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <!-- Center editors -->
            <TabControl Grid.Column="2" Margin="6">
                <!-- Lyric editor -->
                <TabItem Header="歌词">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="200" />
                            <RowDefinition Height="264" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Grid Width="420">
                                <TextBox x:Name="LyricBox" Text="{Binding LyricInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnLyricInputKeyDown" LostFocus="OnLyricInputLostFocus"
                                         ToolTip="输入歌词后按回车，按字典分解为最小声库单位" />
                                <TextBlock Text="输入歌词后回车分解，例如：こんにちは" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"
                                           FontSize="12" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LyricBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="应用歌词" Command="{Binding CommitLyricCommand}" Margin="6,0,0,0" />
                            <TextBlock Text="{Binding LyricStatus}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,6">
                            <TextBlock Text="BPM" VerticalAlignment="Center" />
                            <TextBox Width="58" Margin="4,0,10,0" Text="{Binding Bpm, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="拍/小节" VerticalAlignment="Center" />
                            <TextBox Width="42" Margin="4,0,10,0" Text="{Binding BeatsPerBar, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="单位" VerticalAlignment="Center" />
                            <TextBox Width="42" Margin="4,0,10,0" Text="{Binding BeatUnit, UpdateSourceTrigger=LostFocus}" />
                            <Button Content="{Binding RollModeText}" Command="{Binding ToggleRollModeCommand}" />
                            <ToggleButton Content="画笔" Margin="6,0,0,0" IsChecked="{Binding IsPencil}" />
                            <ComboBox Width="118" Margin="6,0,0,0" SelectedIndex="{Binding GridDivisionIndex}">
                                <ComboBoxItem Content="小格：关闭" />
                                <ComboBoxItem Content="小格：8" />
                                <ComboBoxItem Content="小格：12" />
                                <ComboBoxItem Content="小格：16" />
                                <ComboBoxItem Content="小格：32" />
                            </ComboBox>
                            <Button Content="导入 BGM" Margin="10,0,0,0" Command="{Binding ImportBgmCommand}" />
                            <Button Content="清除 BGM" Command="{Binding ClearBgmCommand}" />
                            <TextBlock Text="{Binding BgmName}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       MaxWidth="96" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource DimBrush}"
                                       ToolTip="{Binding BgmName}" />
                        </StackPanel>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="4">
                            <controls:PianoRollView x:Name="PianoRoll"
                                                    Lyric="{Binding ActiveLyric}"
                                                    Bpm="{Binding Bpm}"
                                                    BeatsPerBar="{Binding BeatsPerBar}"
                                                    HasBgm="{Binding HasBgm}"
                                                    BgmStartBeat="{Binding BgmStartBeat}"
                                                    BgmDurationBeats="{Binding BgmDurationBeats}"
                                                    Mode="{Binding RollMode}"
                                                    IsPencil="{Binding IsPencil}"
                                                    GridDivision="{Binding GridDivision}"
                                                    Revision="{Binding RollRevision}"
                                                    SelectedNoteIndex="{Binding SelectedNoteIndex, Mode=TwoWay}"
                                                    SelectedPitchIndex="{Binding SelectedPitchIndex, Mode=TwoWay}"
                                                    PlayheadBeat="{Binding PlayheadBeat, Mode=TwoWay}"
                                                    EditCommitted="OnRollEditCommitted"
                                                    PlayheadGrabbed="OnRollPlayheadGrabbed"
                                                    NoteAddRequested="OnRollNoteAddRequested"
                                                    NoteDrawRequested="OnRollNoteDrawRequested" />
                        </Border>

                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="发音段">
                                <ListBox ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="22" />
                                                    <TextBlock Text="{Binding Lyric}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding RangeText}" FontSize="11"
                                                           Foreground="{DynamicResource DimBrush}" />
                                                <TextBlock Text="{Binding FormantText}" FontSize="11"
                                                           Foreground="{DynamicResource DimBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="歌词音节（元音 / 共振峰）" Margin="6,0,6,0">
                                <ListBox ItemsSource="{Binding LyricUnits}" SelectedItem="{Binding SelectedUnit}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Caption}" Width="96" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Vowel}" Width="28"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding BeatText}" FontSize="11"
                                                           Foreground="{DynamicResource DimBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="共振峰目标（Hz）">
                                <StackPanel>
                                    <TextBlock Text="{Binding UnitFormantInfo}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource DimBrush}" />
                                    <!-- Graphical view of the 7 formant targets so the numbers are readable at a glance. -->
                                    <controls:FormantBarsView Height="72" Margin="0,6,0,0"
                                                              Values="{Binding UnitFormantValues}"
                                                              Hint="{Binding UnitFormantHint}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="元音" VerticalAlignment="Center" />
                                        <ComboBox Width="60" Margin="4,0,0,0"
                                                  ItemsSource="{Binding VowelChoices}"
                                                  SelectedItem="{Binding UnitVowel}" />
                                    </StackPanel>
                                    <TextBox Margin="0,6,0,0" Text="{Binding UnitFormantText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="7 个目标位置，用逗号分隔，必须递增：800,1200,2500,3400,4000,4500,5000" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="手动设置" Command="{Binding ApplyUnitFormantsCommand}" />
                                        <Button Content="恢复自动" Command="{Binding ClearUnitFormantsCommand}" />
                                    </StackPanel>
                                    <CheckBox Margin="0,8,0,0" IsChecked="{Binding UnitUsesAbsoluteAudio}"
                                              Content="使用绝对样本路径"
                                              ToolTip="勾选后优先使用该音节的绝对音频路径，而不是声库音素解析。" />
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Parameter editor: one node graph per parameter set -->
                <TabItem Header="参数">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="238" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock Text="{Binding GraphOwnerText}" FontWeight="Bold" />
                                <TextBlock Text="四个汇总节点（共振峰位置/增益/带宽、气声参数）接到参数输出节点后生效；未连接时使用声库与歌词的默认值。"
                                           FontSize="11" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding ParameterKeyRows}" SelectedItem="{Binding SelectedParameterKey}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Text="{Binding Group}" FontSize="10"
                                                           Foreground="{DynamicResource DimBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" />

                        <Grid Grid.Column="2" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="262" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <CheckBox Content="编辑歌手叠加图" IsChecked="{Binding EditSingerGraph}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="基础值" Margin="16,0,4,0" VerticalAlignment="Center" />
                                    <TextBox Width="90" IsEnabled="{Binding IsBaseEditable}"
                                             Text="{Binding BaseValue, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox Width="118" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                              ItemsSource="{Binding NodeKinds}" SelectedItem="{Binding NewNodeKind}"
                                              ToolTip="选择要添加的节点类型">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="添加节点" Command="{Binding AddNodeCommand}" />
                                    <Button Content="删除选中节点" Command="{Binding RemoveNodeCommand}" />
                                    <Button Content="缩放到全部" Command="{Binding FrameGraphCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" ClipToBounds="True">
                                <controls:NodeGraphView Graph="{Binding ActiveGraph}"
                                                        SelectedNode="{Binding SelectedNode}"
                                                        Revision="{Binding GraphRevision}"
                                                        FrameRevision="{Binding FrameRevision}" />
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <Grid>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8"
                                            Visibility="{Binding SelectedNodeRow, Converter={StaticResource NotNullVis}}">
                                        <StackPanel DataContext="{Binding SelectedNodeRow}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding KindTitle}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Subtitle}" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource DimBrush}" />
                                                <CheckBox Content="静音" IsChecked="{Binding Muted}" Margin="16,0,0,0" />
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                          ItemsSource="{Binding DataContext.NodeKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Kind}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="标题" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBox Grid.Row="0" Grid.Column="3" Margin="0,2"
                                                         Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="自定义节点标题，留空则使用类型名" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="参数键" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ParameterKey}" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ParameterKey}"
                                                          ItemsSource="{Binding DataContext.ParameterKeyRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                                          SelectedValue="{Binding ParameterKey}" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="全局变量" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Global}" />
                                                <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Global}"
                                                          ItemsSource="{Binding DataContext.GlobalVariables, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Global}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="函数" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Function}" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Function}"
                                                          ItemsSource="{Binding DataContext.MathFunctions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Function}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="数值 A" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ValueA}" />
                                                <TextBox Grid.Row="2" Grid.Column="3" Margin="0,2"
                                                         Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ValueA}"
                                                         Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="数值 B" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ValueB}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2"
                                                         Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=ValueB}"
                                                         Text="{Binding ValueB, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="起始拍 / 结束拍" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Beats}" />
                                                <Grid Grid.Row="3" Grid.Column="3" Margin="0,2"
                                                      Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Beats}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding StartBeat, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBox Grid.Column="2" Text="{Binding EndBeat, UpdateSourceTrigger=LostFocus}" />
                                                </Grid>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="元音" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Vowel}" />
                                                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Vowel}"
                                                          ItemsSource="{Binding DataContext.VowelChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Vowel}"
                                                          ToolTip="留空 = 跟随歌词元音" />
                                                <TextBlock Grid.Row="4" Grid.Column="2" Text="共振峰序号" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           ToolTip="0 = F1 … 6 = F7"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=FormantIndex}" />
                                                <TextBox Grid.Row="4" Grid.Column="3" Margin="0,2"
                                                         Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=FormantIndex}"
                                                         Text="{Binding FormantIndex, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="气声输出" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=BreathOutput}" />
                                                <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=BreathOutput}"
                                                          ItemsSource="{Binding DataContext.BreathOutputs, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding BreathOutput}" />
                                                <TextBlock Grid.Row="5" Grid.Column="2" Text="振幅" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Amplitude}" />
                                                <TextBox Grid.Row="5" Grid.Column="3" Margin="0,2"
                                                         Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Amplitude}"
                                                         Text="{Binding Amplitude, UpdateSourceTrigger=LostFocus}" />

                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="手动覆盖" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Manual}" />
                                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2"
                                                         Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Manual}"
                                                         Text="{Binding ManualValueText, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="留空 = 不使用手动值" />
                                                <CheckBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" Content="使用声库测量值"
                                                          Margin="8,4,0,0" VerticalAlignment="Top"
                                                          IsChecked="{Binding UseVoicebank}"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=UseVoicebank}" />

                                                <TextBlock Grid.Row="7" Grid.Column="0" Text="字段" VerticalAlignment="Center"
                                                           Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Field}" />
                                                <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,2"
                                                          Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Field}"
                                                          ItemsSource="{Binding DataContext.VoicebankFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                                          SelectedValue="{Binding Field}"
                                                          ToolTip="连接声库数据后，输出所选字段的值" />
                                            </Grid>

                                            <TextBlock Text="未连线的输入跟随声库/歌词默认值；汇总节点接到参数输出后立即生效。"
                                                       FontSize="11" Margin="0,8,0,2" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=SummaryHint}" />

                                            <TextBlock Text="输入默认值（未连线的插口）" FontSize="11" Margin="0,8,0,2"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Inputs}" />
                                            <TextBox Text="{Binding InputDefaultsText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="按插口顺序，用逗号分隔，例如 0, 1, 0.5"
                                                     Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Inputs}" />

                                            <TextBlock Text="曲线关键点" FontSize="11" Margin="0,8,0,2"
                                                       Foreground="{DynamicResource DimBrush}"
                                                       Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Curve}" />
                                            <TextBox Text="{Binding CurveText, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="格式：拍:值，逗号分隔，例如 0:0, 0.5:1, 1:0"
                                                     Visibility="{Binding Kind, Converter={StaticResource NodeFieldVis}, ConverterParameter=Curve}" />

                                            <TextBlock Text="节点预览" FontSize="11" Margin="0,8,0,4"
                                                       Foreground="{DynamicResource DimBrush}" />
                                            <controls:SparklineView Height="64" Values="{Binding Preview}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="在画布上选择节点查看参数；右键画布可添加节点。"
                                               Style="{StaticResource EmptyHint}"
                                               VerticalAlignment="Top" Margin="0,16,0,0"
                                               Visibility="{Binding SelectedNodeRow, Converter={StaticResource NullVis}}" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Singer editor -->
                <TabItem Header="歌手">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                        <StackPanel>
                            <TextBlock Text="歌手 = 声库 + 歌词引用 + 参数引用。歌词一一对应；参数可被多个歌手共享。"
                                       Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="名称" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"
                                         Text="{Binding SelectedSinger.Name, UpdateSourceTrigger=LostFocus}" />

                                <TextBlock Grid.Row="1" Text="声库" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                                          ItemsSource="{Binding Voicebanks}" DisplayMemberPath="Name"
                                          SelectedValuePath="Path"
                                          SelectedValue="{Binding SelectedSingerVoicebank, Mode=TwoWay}" />

                                <TextBlock Grid.Row="2" Text="歌词" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3"
                                          ItemsSource="{Binding Lyrics}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSingerLyric, Mode=TwoWay}" />

                                <TextBlock Grid.Row="3" Text="参数" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                                          ItemsSource="{Binding ParameterSets}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedSingerParameter, Mode=TwoWay}" />

                                <TextBlock Grid.Row="4" Text="混音增益" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <Slider Width="240" Minimum="0" Maximum="2" SmallChange="0.01"
                                            Value="{Binding SelectedSinger.MixGain}" />
                                    <TextBlock Text="{Binding SelectedSinger.MixGainText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="5" Text="启用" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                                          Content="参与渲染" IsChecked="{Binding SelectedSinger.Enabled}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="+ 新建歌手" Command="{Binding AddSingerCommand}" />
                                <Button Content="复制歌手" Command="{Binding DuplicateSingerCommand}" />
                                <Button Content="删除歌手" Command="{Binding RemoveSingerCommand}" />
                            </StackPanel>

                            <TextBlock Text="歌手绑定栈：在「参数」页勾选“编辑歌手的绑定栈”即可在共享参数之上追加时间渐变等节点。"
                                       Margin="0,12,0,0" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                            <Button Content="分析声库共振峰（生成 formants.json）" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Command="{Binding AnalyzeVoicebankCommand}" />
                            <TextBlock Text="声库数据节点输出该声库实测的 F1~F7 与气声系数；缺少 formants.json 时使用内置元音表。"
                                       Margin="0,6,0,0" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="共振峰由歌词管理：音节选择元音后，汇总节点未连线的输入自动跟随声库目标位置；也可在歌词页手动覆盖 F1~F7。"
                                       Margin="0,6,0,0" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Library / dictionary / assets -->
                <TabItem Header="资源库">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="刷新声库" Command="{Binding RefreshLibraryCommand}" />
                                    <Button Content="加入发音段" Command="{Binding AddLibraryItemCommand}"
                                            CommandParameter="{Binding SelectedLibraryItem}" />
                                </StackPanel>
                                <TextBlock Text="{Binding LibraryRoot}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource DimBrush}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryRoot}" />
                                <TextBlock Text="声库样本" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="LibraryList" ItemsSource="{Binding Library}"
                                         SelectedItem="{Binding SelectedLibraryItem}"
                                         DisplayMemberPath="DisplayName" />
                                <TextBlock Text="声库为空。检查声库目录，或点击「刷新声库」。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=LibraryList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}" />

                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导入字典" Command="{Binding ImportDictionaryCommand}" />
                                    <Button Content="插入条目" Command="{Binding InsertDictionaryEntryCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="起始拍" VerticalAlignment="Center" />
                                    <TextBox Width="60" Margin="4,0,10,0"
                                             Text="{Binding DictionaryStartBeat, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="拍长" VerticalAlignment="Center" />
                                    <TextBox Width="60" Margin="4,0,10,0"
                                             Text="{Binding DictionaryBeats, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="音高" VerticalAlignment="Center" />
                                    <TextBox Width="60" Margin="4,0,0,0"
                                             Text="{Binding DictionaryDstPitch, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DictionaryName}" FontWeight="Bold" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding DictionaryPathText}" FontSize="11"
                                           Foreground="{DynamicResource DimBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <Button Content="导出歌词资产" Command="{Binding ExportLyricAssetCommand}" />
                                    <Button Content="导入歌词资产" Command="{Binding ImportLyricAssetCommand}" />
                                    <Button Content="导出参数资产" Command="{Binding ExportParameterAssetCommand}" />
                                    <Button Content="导入参数资产" Command="{Binding ImportParameterAssetCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出音色" Command="{Binding ExportTimbreCommand}" />
                                    <Button Content="导入音色" Command="{Binding ImportTimbreCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding DictionaryEntries}"
                                     SelectedItem="{Binding SelectedDictionaryEntry}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{DynamicResource DimBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <!-- Log panel -->
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="日志" FontWeight="Bold" />
                        <TextBlock Text="{Binding PreviewInfo}" FontSize="11"
                                   Foreground="{DynamicResource DimBrush}" />
                    </StackPanel>
                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource DimBrush}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Kind, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar (transport lives here, like a DAW) -->
        <Border Grid.Row="2" Height="32" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="播放" Padding="10,1" FontSize="11" Command="{Binding PlayCommand}" />
                    <Button Content="停止" Padding="10,1" FontSize="11" Margin="4,0,0,0" Command="{Binding StopCommand}" />
                    <Button Content="取消渲染" Padding="10,1" FontSize="11" Margin="4,0,0,0"
                            Command="{Binding CancelRenderCommand}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <TextBlock Text="· 渲染中" Margin="10,0,0,0" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding EngineInfo}"
                           Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
