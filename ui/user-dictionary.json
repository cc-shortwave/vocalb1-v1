      ]
    },
    {
      "text": "ちゃ",
      "defaultBeats": 1.0,
      "parts": [
        { "audio": "_ち.wav", "weight": 1.0, "keepUnvoicedHead": true },
        { "audio": "_や.wav", "weight": 0.6, "transition": 4 }
      ]
    },
    {
      "text": "あー",
      "defaultBeats": 2.0,
      "parts": [
        { "audio": "_あ.wav", "weight": 1.0, "keepUnvoicedHead": true },
